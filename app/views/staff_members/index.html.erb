<% content_for :title, "Wheelhouse — Staff" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Staff</h1>
  <%= link_to "New staff member", new_staff_member_path, class: "btn btn-primary" %>
</div>

<% if @staff_members.any? %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Role</th>
      </tr>
    </thead>
    <tbody>
      <%= render @staff_members %>
    </tbody>
  </table>
<% else %>
  <p>No staff on file yet.</p>
<% end %>
