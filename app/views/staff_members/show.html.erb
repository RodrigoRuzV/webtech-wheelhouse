<% content_for :title, @staff_member.name %>

<p><%= link_to "← Back to staff", staff_members_path %></p>

<h1><%= @staff_member.name %></h1>
<p class="lead"><%= @staff_member.role.capitalize %></p>

<div class="d-flex gap-2 mb-4">
  <%= link_to "Edit", edit_staff_member_path(@staff_member), class: "btn btn-outline-primary" %>
  <%= button_to "Delete", @staff_member, method: :delete, class: "btn btn-outline-danger",
        form: { data: { turbo_confirm: "Delete #{@staff_member.name} from the staff? This can't be undone." } } %>
</div>

<h2>Repairs as mechanic</h2>
<% if @mechanic_repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th scope="col"><span class="visually-hidden">Intake photo</span></th>
        <th scope="col">Bike</th>
        <th scope="col">Customer</th>
        <th scope="col">Status</th>
        <th scope="col">Promised</th>
        <th scope="col">Diagnosis</th>
      </tr>
    </thead>
    <tbody>
      <%= render @mechanic_repairs %>
    </tbody>
  </table>
<% else %>
  <p>Not currently assigned to any repair as mechanic.</p>
<% end %>
