<% content_for :title, "Wheelhouse — Sign in" %>

<%# Lab 11: written by the authentication generator, restyled to match the
    other forms. The alert of a refused sign-in is drawn by the layout's
    flash, and says the same thing for an unknown email address and for a
    wrong password. %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <h1>Sign in</h1>
    <p class="lead">For the people of the workshop.</p>

    <%= form_with url: session_path, data: { turbo: false } do |form| %>
      <div class="mb-3">
        <%= form.label :email_address, "Email address", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address], class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :password, class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password",
              maxlength: 72, class: "form-control" %>
      </div>

      <%= form.submit "Sign in", class: "btn btn-primary" %>
    <% end %>

    <ul class="list-unstyled mt-3">
      <li><%= link_to "Forgot your password?", new_password_path %></li>
      <li>No account yet? <%= link_to "Create an account", new_registration_path %></li>
    </ul>
  </div>
</div>
