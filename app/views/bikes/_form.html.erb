<%# The one form for a bike, rendered by new and edit. The owner is a
    select that shows each customer by name and sends their id. %>
<%# data-turbo="false": the form is submitted by the browser itself, not
    by Turbo, so a refused write (422) leaves the URL bar at the path the
    form was posted to (/bikes or /bikes/:id) and a valid one follows the
    redirect like any page. It also means the form behaves the same with
    JavaScript turned off. %>
<%= form_with model: bike, data: { turbo: false } do |f| %>
  <%= render "shared/error_summary", object: bike %>

  <div class="mb-3">
    <%= f.label :customer_id, "Owner", class: "form-label" %>
    <%= f.collection_select :customer_id, customers, :id, :name,
          { include_blank: "Choose the owner" },
          class: field_class(f, :customer_id, :customer, base: "form-select") %>
    <%= field_errors(f, :customer_id, :customer) %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :make, class: "form-label" %>
      <%= f.text_field :make, class: field_class(f, :make) %>
      <%= field_errors(f, :make) %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :model, class: "form-label" %>
      <%= f.text_field :model, class: field_class(f, :model) %>
      <%= field_errors(f, :model) %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :serial_number, class: "form-label" %>
    <%= f.text_field :serial_number, class: field_class(f, :serial_number) %>
    <%= field_errors(f, :serial_number) %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>
