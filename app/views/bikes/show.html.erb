<% content_for :title, "#{@bike.make} #{@bike.model}" %>

<p><%= link_to "&larr; Back to bikes".html_safe, bikes_path %></p>

<h1><%= @bike.make %> <%= @bike.model %></h1>
<p class="lead">
  Serial number <%= @bike.serial_number %>
  &mdash; owner: <%= link_to @bike.customer.name, @bike.customer %>
</p>

<div class="d-flex gap-2 mb-4">
  <%= link_to "Edit", edit_bike_path(@bike), class: "btn btn-outline-primary" %>
  <%= button_to "Delete", @bike, method: :delete, class: "btn btn-outline-danger",
        form: { data: { turbo_confirm: "Delete bike #{@bike.serial_number} (#{@bike.make} #{@bike.model})? This can't be undone." } } %>
</div>

<div class="d-flex justify-content-between align-items-center">
  <h2>Repairs</h2>
  <%= link_to "Take in a repair for this bike", new_repair_path(bike_id: @bike.id), class: "btn btn-sm btn-outline-secondary" %>
</div>
<% if @repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th scope="col">Bike</th>
        <th scope="col">Customer</th>
        <th scope="col">Status</th>
        <th scope="col">Promised</th>
      </tr>
    </thead>
    <tbody>
      <%= render @repairs %>
    </tbody>
  </table>
<% else %>
  <p>This bike hasn't been in for a repair yet.</p>
<% end %>
