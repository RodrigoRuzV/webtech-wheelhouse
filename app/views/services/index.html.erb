<% content_for :title, "Wheelhouse — Services" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Services &amp; prices</h1>
  <%= link_to "New service", new_service_path, class: "btn btn-primary" %>
</div>
<p class="lead">Every job we do comes from this list. Prices shown are our standard rate.</p>

<% if @services.any? %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col">Job</th>
        <th scope="col" class="text-end">Price</th>
      </tr>
    </thead>
    <tbody>
      <%= render @services %>
    </tbody>
  </table>
<% else %>
  <p>There are no services on the price list yet.</p>
<% end %>
