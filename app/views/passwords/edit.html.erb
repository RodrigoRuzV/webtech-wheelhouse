<% content_for :title, "Wheelhouse — Choose a new password" %>

<%# Lab 11: written by the authentication generator, restyled. A refused
    password (too short, or the two don't match) is drawn again with status
    422 and its messages next to the fields, as every refused write. The
    fields stay top-level (password, password_confirmation), as the
    generator's controller reads them. %>
<% password_errors = @user.errors.full_messages_for(:password) %>
<% confirmation_errors = @user.errors.full_messages_for(:password_confirmation) %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <h1>Choose a new password</h1>

    <%= form_with url: password_path(params[:token]), method: :put, data: { turbo: false } do |form| %>
      <%= render "shared/error_summary", object: @user %>

      <div class="mb-3">
        <%= form.label :password, "New password", class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password",
              minlength: User::MIN_PASSWORD_LENGTH, maxlength: 72,
              class: "form-control#{' is-invalid' if password_errors.any?}",
              aria: { describedby: "password_help" } %>
        <% if password_errors.any? %>
          <div class="invalid-feedback"><%= safe_join(password_errors, tag.br) %></div>
        <% end %>
        <div id="password_help" class="form-text">At least <%= User::MIN_PASSWORD_LENGTH %> characters.</div>
      </div>

      <div class="mb-3">
        <%= form.label :password_confirmation, "Repeat the new password", class: "form-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
              maxlength: 72, class: "form-control#{' is-invalid' if confirmation_errors.any?}" %>
        <% if confirmation_errors.any? %>
          <div class="invalid-feedback"><%= safe_join(confirmation_errors, tag.br) %></div>
        <% end %>
      </div>

      <%= form.submit "Save the new password", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
