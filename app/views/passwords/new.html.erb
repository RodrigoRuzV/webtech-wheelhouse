<% content_for :title, "Wheelhouse — Forgot your password?" %>

<%# Lab 11: written by the authentication generator, restyled. Whatever the
    email address, the answer is the same notice: the page never tells
    whether an address has an account. %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <h1>Forgot your password?</h1>
    <p class="lead">We'll email you a link to choose a new one.</p>

    <%= form_with url: passwords_path, data: { turbo: false } do |form| %>
      <div class="mb-3">
        <%= form.label :email_address, "Email address", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address], class: "form-control" %>
      </div>

      <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
    <% end %>

    <p class="mt-3"><%= link_to "← Back to sign in", new_session_path %></p>
  </div>
</div>
