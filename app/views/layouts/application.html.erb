<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wheelhouse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# Lab 11: two navigation bars. A visitor sees the price list and a
        link to sign in, and no link to a page that needs a session (the
        brand goes to the price list, since the home page is closed). A
        signed-in person sees every page, who is signed in with the role,
        and a button that signs out with a DELETE, never a GET.
        authenticated? also resumes the session on the open pages, so the
        price list shows who is signed in too. %>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Wheelhouse", (authenticated? ? root_path : services_path), class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
          <% if authenticated? %>
            <ul class="navbar-nav ms-auto">
              <li class="nav-item">
                <%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Services", services_path, class: "nav-link #{'active' if current_page?(services_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Customers", customers_path, class: "nav-link #{'active' if current_page?(customers_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Bikes", bikes_path, class: "nav-link #{'active' if current_page?(bikes_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Repairs", repairs_path, class: "nav-link #{'active' if current_page?(repairs_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Staff", staff_members_path, class: "nav-link #{'active' if current_page?(staff_members_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Visiting the workshop", visiting_path, class: "nav-link #{'active' if current_page?(visiting_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "About", about_path, class: "nav-link #{'active' if current_page?(about_path)}" %>
              </li>
            </ul>
            <div class="d-flex align-items-center gap-2 ms-md-3 mt-2 mt-md-0">
              <span class="navbar-text text-light small">
                <%= account_label(Current.user) %>
                <span class="badge text-bg-secondary"><%= Current.user.role.humanize %></span>
              </span>
              <%= button_to "Sign out", session_path, method: :delete,
                    class: "btn btn-outline-light btn-sm", form: { data: { turbo: false } } %>
            </div>
          <% else %>
            <ul class="navbar-nav ms-auto">
              <li class="nav-item">
                <%= link_to "Price list", services_path, class: "nav-link #{'active' if current_page?(services_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Sign in", new_session_path, class: "nav-link #{'active' if current_page?(new_session_path)}" %>
              </li>
            </ul>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
