<% content_for :title, @customer.name %>

<p><%= link_to "&larr; Back to customers".html_safe, customers_path %></p>

<h1><%= @customer.name %></h1>
<p class="lead"><%= @customer.phone %></p>

<div class="d-flex gap-2 mb-4">
  <%= link_to "Edit", edit_customer_path(@customer), class: "btn btn-outline-primary" %>
  <%= button_to "Delete", @customer, method: :delete, class: "btn btn-outline-danger",
        form: { data: { turbo_confirm: "Delete customer #{@customer.name}? This can't be undone." } } %>
</div>

<div class="d-flex justify-content-between align-items-center">
  <h2>Bikes</h2>
  <%= link_to "Add a bike for #{@customer.name}", new_bike_path(customer_id: @customer.id), class: "btn btn-sm btn-outline-secondary" %>
</div>
<% if @bikes.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th scope="col">Make</th>
        <th scope="col">Model</th>
        <th scope="col">Serial number</th>
        <th scope="col">Owner</th>
      </tr>
    </thead>
    <tbody>
      <%= render @bikes %>
    </tbody>
  </table>
<% else %>
  <p>This customer hasn't registered a bike yet.</p>
<% end %>

<h2>Repairs</h2>
<% if @repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th scope="col">Bike</th>
        <th scope="col">Customer</th>
        <th scope="col">Status</th>
        <th scope="col">Promised</th>
      </tr>
    </thead>
    <tbody>
      <%= render @repairs %>
    </tbody>
  </table>
<% else %>
  <p>No repairs on file for this customer.</p>
<% end %>
