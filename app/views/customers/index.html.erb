<% content_for :title, "Wheelhouse — Customers" %>

<h1>Customers</h1>

<% if @customers.any? %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Phone</th>
      </tr>
    </thead>
    <tbody>
      <%= render @customers %>
    </tbody>
  </table>
<% else %>
  <p>There are no customers yet.</p>
<% end %>
