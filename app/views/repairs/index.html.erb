<% content_for :title, "Wheelhouse — Repairs" %>

<h1>Repairs</h1>

<% if @repairs.any? %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col">Bike</th>
        <th scope="col">Customer</th>
        <th scope="col">Status</th>
        <th scope="col">Promised</th>
      </tr>
    </thead>
    <tbody>
      <%= render @repairs %>
    </tbody>
  </table>
<% else %>
  <p>No repairs on file yet.</p>
<% end %>
