<% content_for :title, "Wheelhouse — Repairs" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Repairs</h1>
  <%= link_to "New repair", new_repair_path, class: "btn btn-primary" %>
</div>

<% if @repairs.any? %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col"><span class="visually-hidden">Intake photo</span></th>
        <th scope="col">Bike</th>
        <th scope="col">Customer</th>
        <th scope="col">Status</th>
        <th scope="col">Promised</th>
        <th scope="col">Taken in by</th>
        <th scope="col">Diagnosis</th>
      </tr>
    </thead>
    <tbody>
      <%# Lab 11: only the repairs index shows who took each repair in; the
          other lists that render this partial don't preload intake_user. %>
      <%= render partial: "repairs/repair", collection: @repairs, locals: { show_intake: true } %>
    </tbody>
  </table>
<% else %>
  <p>No repairs on file yet.</p>
<% end %>
