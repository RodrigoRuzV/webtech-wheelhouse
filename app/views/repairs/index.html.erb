<% content_for :title, "Wheelhouse — Repairs" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Repairs</h1>
  <%= link_to "New repair", new_repair_path, class: "btn btn-primary" %>
</div>

<% if @repairs.any? %>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col"><span class="visually-hidden">Intake photo</span></th>
        <th scope="col">Bike</th>
        <th scope="col">Customer</th>
        <th scope="col">Status</th>
        <th scope="col">Promised</th>
        <th scope="col">Diagnosis</th>
      </tr>
    </thead>
    <tbody>
      <%= render @repairs %>
    </tbody>
  </table>
<% else %>
  <p>No repairs on file yet.</p>
<% end %>
